# ─── Google Gemini ───────────────────────────────────────────────
# API key (required, server-side only — never commit this file as .env)
GEMINI_API_KEY=

# Persona models: comma-separated, round-robin with failover.
# Uses Flash-Lite for higher free-tier quota.
# Verify exact model IDs in your Google AI Studio account.
PERSONA_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Judge models: ordered fallback chain (try first, fall to next on 429/error).
# Uses full Flash for quality.
# Verify exact model IDs in your Google AI Studio account.
JUDGE_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# ─── Feature Flags ──────────────────────────────────────────────
# Demo mode: true = zero API calls, serves pre-saved JSON from /data/examples/
DEMO_MODE=false

# Google Search grounding: optional, off by default, never a core dependency
GROUNDING_ENABLED=false

# ─── Server ─────────────────────────────────────────────────────
# HTTP server port
PORT=3000
